# ==============================================================================
# DOCUMIND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=documind_super_secret_jwt_key_change_in_production_2026
API_PORT=8000
FRONTEND_PORT=5173

# Database (PostgreSQL + pgvector / SQLite for lightweight dev)
# For local dev without Docker: sqlite+aiosqlite:///./documind.db
# For production/Docker: postgresql+asyncpg://documind_user:documind_pass@db:5432/documind_db
DATABASE_URL=sqlite+aiosqlite:///./documind.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_LOCAL_PATH=./storage/documents
MAX_FILE_SIZE_MB=100

# AI Provider Configuration (Google Gemini / OpenAI)
# Gemini 1.5 Flash is recommended for fast, cost-effective RAG & long-context citation
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

# Vector DB
VECTOR_SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=5
HYBRID_SEARCH_ALPHA=0.5 # 0 = BM25 only, 1 = Vector only, 0.5 = Balanced
